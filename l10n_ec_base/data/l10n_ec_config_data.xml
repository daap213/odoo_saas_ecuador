    <record id="l10n_ec_config_2026" model="l10n_ec.config">
        <field name="year">2026</field>
        <!-- Parámetros Laborales (MDT) -->
        <field name="sbu">482.0</field>
        <field name="recargo_suplementaria">50.0</field>
        <field name="recargo_extraordinaria">100.0</field>
        <field name="recargo_nocturna">25.0</field>
        <field name="dias_vacaciones">15</field>
        <field name="dias_adicionales_5_anos">1</field>
        <!-- Parámetros IESS -->
        <field name="iess_personal">9.45</field>
        <field name="iess_patronal">11.15</field>
        <field name="iess_secap">0.5</field>
        <field name="iess_iece">0.5</field>
        <field name="iess_techo_sbu_multiplicador">25</field>
        <field name="fondos_reserva">8.33</field>
        <!-- Parámetros Tributarios (SRI) -->
        <field name="iva_general">15.0</field>
        <field name="iva_construccion">5.0</field>
        <field name="isd">5.0</field>
        <field name="isd_exencion">5000.0</field>
        <field name="limite_consumidor_final">50.0</field>
        <!-- Estadísticas INEC -->
        <field name="canasta_basica">808.95</field>
        <field name="canasta_vital">576.12</field>
    </record>

    <!-- ================================================================= -->
    <!-- CÓDIGOS DE IMPUESTOS SRI                                          -->
    <!-- ================================================================= -->
    <record id="tax_code_iva_15" model="l10n_ec.tax.code">
        <field name="code">4</field>
        <field name="name">IVA 15%</field>
        <field name="rate">15.0</field>
        <field name="tax_type">iva</field>
    </record>
    <record id="tax_code_iva_5" model="l10n_ec.tax.code">
        <field name="code">5</field>
        <field name="name">IVA 5% (Construcción)</field>
        <field name="rate">5.0</field>
        <field name="tax_type">iva</field>
    </record>
    <record id="tax_code_iva_0" model="l10n_ec.tax.code">
        <field name="code">0</field>
        <field name="name">IVA 0%</field>
        <field name="rate">0.0</field>
        <field name="tax_type">iva</field>
    </record>
    <record id="tax_code_iva_no_objeto" model="l10n_ec.tax.code">
        <field name="code">6</field>
        <field name="name">No Objeto de IVA</field>
        <field name="rate">0.0</field>
        <field name="tax_type">iva</field>
    </record>
    <record id="tax_code_iva_exento" model="l10n_ec.tax.code">
        <field name="code">7</field>
        <field name="name">IVA Exento</field>
        <field name="rate">0.0</field>
        <field name="tax_type">iva</field>
    </record>
