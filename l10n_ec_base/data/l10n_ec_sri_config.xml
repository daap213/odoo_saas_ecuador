<?xml version="1.0" encoding="utf-8"?>
<!--
    Parámetros regulatorios del SRI — Datos Abiertos

    NINGÚN VALOR HARDCODEADO: todo lo que fija una resolución del SRI vive aquí, no
    en el código, para que un cambio de normativa (una tarifa de IVA nueva, otro
    límite de consumidor final, otro plazo de anulación) sea un cambio de dato.

    DÓNDE SE TOCAN: Ajustes > Técnico > Parámetros del sistema, **en modo
    desarrollador**, y a propósito. No están en la página de Ajustes de Contabilidad.

    El motivo no es comodidad sino riesgo: no son preferencias del usuario, son
    valores que fija la ley. Un contador que baje el IVA al 12 % o suba el límite de
    consumidor final desde una pantalla de ajustes no rompe nada visible — sigue
    emitiendo, y emite comprobantes no conformes hasta que el SRI los rechaza o,
    peor, los autoriza mal. Cambiarlos exige saber qué resolución los respalda, y
    modo desarrollador es la barrera que garantiza que quien entra lo sabe.

    Lo que SÍ es decisión de la empresa —certificado de firma, ambiente, si está
    obligada a llevar contabilidad, sus resoluciones de contribuyente especial o de
    agente de retención— vive en la ficha de la compañía, pestaña "SRI Ecuador".

    Referencia: https://www.sri.gob.ec/datos-abiertos
    Ficha Técnica de comprobantes electrónicos, versión 2.34 (julio 2026)
    Resolución: NAC-DGERCGC25-00000017
-->
<odoo>
    <data noupdate="0">

        <!-- ================================================================
             SRI 2026 REGULATORY PARAMETERS
             All values configurable, no hardcoding
        ================================================================= -->

        <!-- Consumidor Final Configuration -->
        <record id="l10n_ec_consumidor_final_ruc" model="ir.config_parameter">
            <field name="key">l10n_ec.consumidor_final_ruc</field>
            <field name="value">9999999999999</field>
        </record>

        <record id="l10n_ec_consumidor_final_limit" model="ir.config_parameter">
            <field name="key">l10n_ec.consumidor_final_limit</field>
            <field name="value">50.00</field>
        </record>

        <!-- Annulment Rule -->
        <record id="l10n_ec_annulment_day_limit" model="ir.config_parameter">
            <field name="key">l10n_ec.annulment_day_limit</field>
            <field name="value">7</field>
        </record>

        <!-- Tax Rates 2026 -->
        <record id="l10n_ec_iva_rate" model="ir.config_parameter">
            <field name="key">l10n_ec.iva_rate</field>
            <field name="value">15</field>
        </record>

        <record id="l10n_ec_iva_rate_construccion" model="ir.config_parameter">
            <field name="key">l10n_ec.iva_rate_construccion</field>
            <field name="value">5</field>
        </record>

        <!-- Economic Parameters 2026 -->
        <record id="l10n_ec_sbu" model="ir.config_parameter">
            <field name="key">l10n_ec.sbu</field>
            <field name="value">482.00</field>
        </record>

        <record id="l10n_ec_iess_aporte_personal" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_aporte_personal</field>
            <field name="value">9.45</field>
        </record>

        <record id="l10n_ec_iess_aporte_patronal" model="ir.config_parameter">
            <field name="key">l10n_ec.iess_aporte_patronal</field>
            <field name="value">11.15</field>
        </record>

        <!-- ================================================================
             SRI WEB SERVICE ENDPOINTS
             Source: open-factura / SRI Official
        ================================================================= -->

        <!-- Ambiente de PRUEBAS (Test) -->
        <record id="l10n_ec_sri_reception_url_test" model="ir.config_parameter">
            <field name="key">l10n_ec.sri_reception_url_test</field>
            <field name="value">https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl</field>
        </record>

        <record id="l10n_ec_sri_authorization_url_test" model="ir.config_parameter">
            <field name="key">l10n_ec.sri_authorization_url_test</field>
            <field name="value">https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl</field>
        </record>

        <!-- Ambiente de PRODUCCIÓN -->
        <record id="l10n_ec_sri_reception_url_prod" model="ir.config_parameter">
            <field name="key">l10n_ec.sri_reception_url_prod</field>
            <field name="value">https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl</field>
        </record>

        <record id="l10n_ec_sri_authorization_url_prod" model="ir.config_parameter">
            <field name="key">l10n_ec.sri_authorization_url_prod</field>
            <field name="value">https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl</field>
        </record>

        <!-- RUC Consultation API -->
        <record id="l10n_ec_sri_ruc_api_url" model="ir.config_parameter">
            <field name="key">l10n_ec.sri_ruc_api_url</field>
            <field name="value">https://srienlinea.sri.gob.ec/sri-catastro-sujeto-servicio-internet/rest/ConsolidadoContribuyente/obtenerPorNumerosRuc</field>
        </record>

        <!-- Current Environment Setting -->
        <record id="l10n_ec_sri_environment" model="ir.config_parameter">
            <field name="key">l10n_ec.sri_environment</field>
            <field name="value">test</field>
        </record>

        <!-- Auto-send to SRI on Invoice Post (2026 requirement: immediate) -->
        <record id="l10n_ec_auto_send_sri" model="ir.config_parameter">
            <field name="key">l10n_ec.auto_send_sri</field>
            <field name="value">True</field>
        </record>

        <!-- Forma de pago por defecto del bloque <pagos> (tabla 24 de la Ficha).
             01 = Sin utilización del sistema financiero. Se usa cuando la factura
             no declara una forma de pago concreta. <pagos> es OBLIGATORIO: sin él
             el comprobante no pasa la validación de esquema (error 35). -->
        <record id="l10n_ec_default_payment_method_code" model="ir.config_parameter">
            <field name="key">l10n_ec.default_payment_method_code</field>
            <field name="value">01</field>
        </record>

        <!-- Anexo 26 (Res. NAC-DGERCGC26-00000027): quien emite con un facturador
             de terceros debe declarar el RUC del proveedor del sistema en
             <infoAdicional nombre="RUC Proveedor">. Vacío = no se emite la etiqueta.
             Rellenar con el RUC del proveedor del software cuando corresponda. -->
        <record id="l10n_ec_software_provider_ruc" model="ir.config_parameter">
            <field name="key">l10n_ec.software_provider_ruc</field>
            <field name="value"></field>
        </record>

        <!-- ================================================================
             SRI DOCUMENT TYPE CODES
             Required for electronic documents
        ================================================================= -->

        <record id="l10n_ec_doc_type_factura" model="ir.config_parameter">
            <field name="key">l10n_ec.doc_type.factura</field>
            <field name="value">01</field>
        </record>

        <record id="l10n_ec_doc_type_nota_credito" model="ir.config_parameter">
            <field name="key">l10n_ec.doc_type.nota_credito</field>
            <field name="value">04</field>
        </record>

        <record id="l10n_ec_doc_type_nota_debito" model="ir.config_parameter">
            <field name="key">l10n_ec.doc_type.nota_debito</field>
            <field name="value">05</field>
        </record>

        <record id="l10n_ec_doc_type_guia_remision" model="ir.config_parameter">
            <field name="key">l10n_ec.doc_type.guia_remision</field>
            <field name="value">06</field>
        </record>

        <record id="l10n_ec_doc_type_retencion" model="ir.config_parameter">
            <field name="key">l10n_ec.doc_type.retencion</field>
            <field name="value">07</field>
        </record>

        <record id="l10n_ec_doc_type_liq_compra" model="ir.config_parameter">
            <field name="key">l10n_ec.doc_type.liq_compra</field>
            <field name="value">03</field>
        </record>

        <!-- ================================================================
             TAX CALENDAR CONFIGURATION
             Fechas de vencimiento según noveno dígito RUC
        ================================================================= -->

        <!-- Deadline day map by 9th RUC digit (JSON format) -->
        <record id="l10n_ec_deadline_day_map" model="ir.config_parameter">
            <field name="key">l10n_ec.deadline_day_map</field>
            <field name="value">{"1": 10, "2": 12, "3": 14, "4": 16, "5": 18, "6": 20, "7": 22, "8": 24, "9": 26, "0": 28}</field>
        </record>

        <!-- Special Contributor deadline day -->
        <record id="l10n_ec_special_contributor_day" model="ir.config_parameter">
            <field name="key">l10n_ec.special_contributor_day</field>
            <field name="value">9</field>
        </record>

        <!-- RDEP deadline map (January submission for previous year) -->
        <record id="l10n_ec_rdep_deadline_map" model="ir.config_parameter">
            <field name="key">l10n_ec.rdep_deadline_map</field>
            <field name="value">{"1": "01-21", "2": "01-23", "3": "01-25", "4": "01-27", "5": "01-29", "6": "01-31", "7": "02-03", "8": "02-05", "9": "02-07", "0": "02-07"}</field>
        </record>

        <!-- IR declaration months -->
        <record id="l10n_ec_ir_natural_month" model="ir.config_parameter">
            <field name="key">l10n_ec.ir_natural_month</field>
            <field name="value">3</field>
        </record>

        <record id="l10n_ec_ir_sociedades_month" model="ir.config_parameter">
            <field name="key">l10n_ec.ir_sociedades_month</field>
            <field name="value">4</field>
        </record>

        <!-- ================================================================
             CUSTOMS (ADUANAS) CONFIGURATION
        ================================================================= -->

        <record id="l10n_ec_fodinfa" model="ir.config_parameter">
            <field name="key">l10n_ec.fodinfa</field>
            <field name="value">0.005</field>
        </record>

        <record id="l10n_ec_customs_iva" model="ir.config_parameter">
            <field name="key">l10n_ec.customs_iva</field>
            <field name="value">0.15</field>
        </record>


        <!-- Jornada mensual en horas: 8 h × 30 días (Código de Trabajo Art. 47).
             Es el divisor con el que se obtiene el valor de la hora ordinaria, y
             estaba escrito como un `240` dentro de la fórmula de la nómina. -->
        <record id="l10n_ec_jornada_mensual_horas" model="ir.config_parameter">
            <field name="key">l10n_ec.jornada_mensual_horas</field>
            <field name="value">240</field>
        </record>

        <!-- Tabla 20: el código de retención del ISD pasó de 4580 a 4586 con el 2,5 %
             vigente desde esta fecha. Se siembra como parámetro porque es una fecha
             de vigencia normativa: si cambia, cambia el dato, no el código. -->
        <record id="l10n_ec_isd_code_4586_from" model="ir.config_parameter">
            <field name="key">l10n_ec.isd_code_4586_from</field>
            <field name="value">2025-05-01</field>
        </record>

        <!-- Penalización por retraso en contratación con el Estado (DE 045-2025).
             `purchase_order._compute_penalty` LEE estos dos parámetros y nadie los
             sembraba: el defecto "0" hacía que el método saliera por `continue` y
             desactivara toda la penalización, sin un solo error. Ahora están a cero
             explícitamente, que es lo correcto para quien no contrata con el Estado,
             y quien sí lo hace tiene dónde poner su tasa.

             La tasa es POR MIL diario sobre el monto del contrato; el tope, un
             porcentaje del mismo monto. -->
        <record id="l10n_ec_penalty_rate_daily" model="ir.config_parameter">
            <field name="key">l10n_ec.penalty_rate_daily</field>
            <field name="value">0</field>
        </record>

        <record id="l10n_ec_penalty_cap_percent" model="ir.config_parameter">
            <field name="key">l10n_ec.penalty_cap_percent</field>
            <field name="value">0</field>
        </record>

        <!-- Tope mensual de horas extra (Art. 55: 12 semanales x 4 semanas). Es una
             aproximación sobre un rol mensual, por eso se deja ajustable. -->
        <record id="l10n_ec_horas_extra_tope_mensual" model="ir.config_parameter">
            <field name="key">l10n_ec.horas_extra_tope_mensual</field>
            <field name="value">48</field>
        </record>
    </data>
</odoo>

