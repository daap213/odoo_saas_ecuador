<?xml version="1.0" encoding="utf-8"?>
<!--
    Bloque "Ecuador — SRI" dentro de los ajustes de Contabilidad.

    Hasta ahora los ~30 parámetros regulatorios sólo se editaban en
    Ajustes > Técnico > Parámetros del sistema, que exige modo desarrollador. En la
    práctica no los configuraba nadie: el RUC del proveedor de facturación que exige
    el Anexo 26, por ejemplo, se quedaba vacío y la etiqueta simplemente no se emitía.
-->
<odoo>

    <record id="res_config_settings_view_form_l10n_ec" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ec</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Justo detrás de "Localización fiscal", que es donde el usuario acaba
                 de elegir Ecuador. Los nombres de bloque de `account` cambian entre
                 versiones: en Odoo 19 los válidos son
                 fiscal_localization_setting_container, default_taxes_setting_container
                 y main_currency_setting_container. -->
            <xpath expr="//block[@name='fiscal_localization_setting_container']" position="after">
                <block title="Ecuador — SRI" name="l10n_ec_sri_block"
                       invisible="country_code != 'EC'">

                    <!-- El ambiente SRI y el certificado se añaden aquí desde
                         l10n_ec_edi, que es quien declara esos campos en res.company. -->

                    <setting id="l10n_ec_auto_send_setting"
                             string="Enviar al SRI al validar"
                             help="Transmite el comprobante en cuanto se publica el asiento. Un fallo se registra pero no bloquea la contabilización.">
                        <field name="l10n_ec_auto_send_sri"/>
                    </setting>

                    <setting id="l10n_ec_provider_setting"
                             string="RUC del proveedor de facturación"
                             help="Anexo 26 de la Ficha Técnica y art. 5 de la Res. NAC-DGERCGC26-00000027: obligatorio para quien emite con un sistema de terceros. Vacío = no se emite la etiqueta.">
                        <field name="l10n_ec_software_provider_ruc" placeholder="1790000000001"/>
                    </setting>

                    <setting id="l10n_ec_consumidor_final_setting"
                             string="Consumidor final"
                             help="Por encima del límite hay que identificar al adquirente (Ficha §9.10).">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_ec_consumidor_final_ruc" class="col-lg-6 o_light_label"/>
                                <field name="l10n_ec_consumidor_final_ruc"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ec_consumidor_final_limit" class="col-lg-6 o_light_label"/>
                                <field name="l10n_ec_consumidor_final_limit"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="l10n_ec_annulment_setting"
                             string="Día límite de anulación"
                             help="Día del mes siguiente hasta el que se puede anular un comprobante autorizado.">
                        <field name="l10n_ec_annulment_day_limit"/>
                    </setting>

                    <setting id="l10n_ec_payment_setting"
                             string="Forma de pago por defecto"
                             help="Tabla 24 de la Ficha. Se usa cuando la factura no indica una forma de pago concreta.">
                        <field name="l10n_ec_default_payment_method_id"
                               options="{'no_create': True}"/>
                    </setting>

                    <setting id="l10n_ec_iva_setting"
                             string="Tarifas de IVA"
                             help="Tarifa general y tarifa reducida de construcción, en porcentaje.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_ec_iva_rate" class="col-lg-6 o_light_label"/>
                                <field name="l10n_ec_iva_rate"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ec_iva_rate_construccion" class="col-lg-6 o_light_label"/>
                                <field name="l10n_ec_iva_rate_construccion"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="l10n_ec_penalty_setting"
                             string="Penalidad por retraso en compras"
                             help="DE 045-2025. Tasa diaria y tope, en porcentaje sobre el total del pedido.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_ec_penalty_rate_daily" class="col-lg-6 o_light_label"/>
                                <field name="l10n_ec_penalty_rate_daily"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ec_penalty_cap_percent" class="col-lg-6 o_light_label"/>
                                <field name="l10n_ec_penalty_cap_percent"/>
                            </div>
                        </div>
                    </setting>

                    <setting id="l10n_ec_urls_setting"
                             string="Endpoints del SRI"
                             help="Sólo hay que tocarlos si el SRI publica direcciones nuevas. El ambiente elige entre el par de pruebas y el de producción.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_ec_sri_reception_url_test" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ec_sri_reception_url_test"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ec_sri_authorization_url_test" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ec_sri_authorization_url_test"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ec_sri_reception_url_prod" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ec_sri_reception_url_prod"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ec_sri_authorization_url_prod" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ec_sri_authorization_url_prod"/>
                            </div>
                            <div class="row">
                                <label for="l10n_ec_sri_ruc_api_url" class="col-lg-5 o_light_label"/>
                                <field name="l10n_ec_sri_ruc_api_url"/>
                            </div>
                        </div>
                    </setting>

                </block>
            </xpath>
        </field>
    </record>

</odoo>
