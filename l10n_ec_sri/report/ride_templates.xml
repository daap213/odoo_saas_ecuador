<?xml version="1.0" encoding="utf-8"?>
<!--
    RIDE — Representación Impresa del Documento Electrónico (Anexo 2).

    Un marco común y un cuerpo por tipo de comprobante. Antes había un único informe
    sobre `account.move` cuya cabecera escribía el literal "FACTURA": impreso sobre una
    nota de crédito, el papel —que según el Anexo 2 tiene validez tributaria y
    jurídica— se declaraba factura, y ese mismo PDF es el que se adjunta al correo de
    entrega al receptor.

    Todo se lee de un único diccionario `v`, el que devuelve `get_ride_values`. La
    versión anterior lo desmontaba en veinte `t-set` que había que mantener en sincronía
    a mano con el Python; cada valor nuevo que alguien olvidara propagar salía como una
    celda vacía en el PDF, sin error.
-->
<odoo>

<!-- ==================================================================
     Marco: cabecera del emisor, datos del comprobante y receptor.
     Idéntico en los seis comprobantes; el Anexo 2 lo maqueta así.
     ================================================================== -->
<template id="report_ride_document">
    <!-- basic_layout y no external_layout: este último imprime su propia cabecera de
         empresa con logo y dirección, que duplicaría el bloque del emisor. -->
    <t t-call="web.basic_layout">
        <div class="page" style="font-size:9pt;">

            <div class="row">
                <div class="col-6" style="border:1px solid #000; padding:6px; min-height:150px;">
                    <span t-if="v['company'].logo" t-field="v['company'].logo"
                          t-options="{'widget': 'image', 'style': 'max-height:50px;'}"/>
                    <div><strong t-out="v['company'].name"/></div>
                    <div t-if="v['company'].l10n_ec_commercial_name">
                        <em t-out="v['company'].l10n_ec_commercial_name"/>
                    </div>
                    <div>Dir. Matriz: <span t-out="v['company'].street"/></div>
                    <div t-if="v['company'].street2">
                        Dir. Sucursal: <span t-out="v['company'].street2"/>
                    </div>
                    <div t-if="v['company'].l10n_ec_special_resolution">
                        Contribuyente Especial Nro.:
                        <span t-out="v['company'].l10n_ec_special_resolution"/>
                    </div>
                    <div>
                        OBLIGADO A LLEVAR CONTABILIDAD:
                        <span t-out="'SI' if v['company'].l10n_ec_forced_accounting else 'NO'"/>
                    </div>
                    <div t-if="v['company'].l10n_ec_withhold_agent and v['company'].l10n_ec_withhold_resolution">
                        <strong>AGENTE DE RETENCIÓN Resolución Nro.
                            <span t-out="v['company'].l10n_ec_withhold_resolution"/></strong>
                    </div>
                    <div t-if="v['rimpe_legend']"><strong t-out="v['rimpe_legend']"/></div>
                </div>

                <div class="col-6" style="border:1px solid #000; padding:6px;">
                    <div>R.U.C.: <strong t-out="v['company'].vat"/></div>
                    <!-- El título real del comprobante, de la tabla 3. -->
                    <h5 style="margin:4px 0;" t-out="v['document_title']"/>
                    <div>No. <strong t-out="v['document_number']"/></div>
                    <div style="margin-top:4px;">
                        <strong>NÚMERO DE AUTORIZACIÓN</strong>
                        <div style="word-break:break-all; font-family:monospace;"
                             t-out="v['access_key']"/>
                    </div>
                    <div>
                        FECHA Y HORA DE AUTORIZACIÓN:
                        <span t-out="v['authorization_date']"/>
                    </div>
                    <div>AMBIENTE: <span t-out="v['environment_label']"/></div>
                    <div>EMISIÓN: NORMAL</div>
                    <div t-if="v['barcode']" style="margin-top:4px;">
                        <img t-att-src="v['barcode']" style="max-width:100%;"
                             alt="Clave de acceso"/>
                    </div>
                </div>
            </div>

            <!-- ============ Receptor ============ -->
            <div style="border:1px solid #000; padding:6px; margin-top:6px;">
                <div>
                    <span t-out="v['counterparty_label']"/>:
                    <span t-out="v['partner'].name"/>
                </div>
                <div>
                    <span t-out="v['counterparty_id_label']"/>:
                    <span t-out="v['buyer_identification']"/>
                    <span style="margin-left:12px;">Fecha Emisión:
                        <span t-out="v['emission_date']"/>
                    </span>
                </div>
                <div t-if="v['partner'].street">
                    Dirección: <span t-out="v['partner'].street"/>
                </div>
            </div>

            <!-- ============ Cuerpo propio del tipo de comprobante ============ -->
            <t t-call="{{ v['body_template'] }}"/>

            <!-- ============ Pie común: información adicional y totales ============ -->
            <div class="row">
                <div class="col-7">
                    <div t-if="v['additional_info']" style="border:1px solid #000; padding:6px;">
                        <strong>Información Adicional</strong>
                        <div t-foreach="v['additional_info']" t-as="info">
                            <span t-out="info[0]"/>: <span t-out="info[1]"/>
                        </div>
                    </div>
                    <table t-if="v['show_payments']" class="table table-sm"
                           style="margin-top:6px; font-size:8pt;">
                        <thead>
                            <tr>
                                <th>Forma de Pago</th>
                                <th class="text-end">Valor</th>
                                <th class="text-end">Plazo</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="v['payments']" t-as="pay">
                                <td t-out="pay['label']"/>
                                <td class="text-end" t-out="pay['total']"/>
                                <td class="text-end">
                                    <span t-if="pay['plazo']">
                                        <span t-out="pay['plazo']"/>
                                        <span t-out="pay['unidadTiempo']"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="col-5" t-if="v['show_totals']">
                    <table class="table table-sm" style="font-size:8pt;">
                        <!-- Sólo los subtotales con contenido (nota del Anexo 2). -->
                        <tr t-foreach="v['subtotals']" t-as="sub">
                            <td t-out="sub['label']"/>
                            <td class="text-end" t-out="sub['amount']"/>
                        </tr>
                        <tr>
                            <td>TOTAL DESCUENTO</td>
                            <td class="text-end" t-out="v['total_discount']"/>
                        </tr>
                        <tr t-if="v['has_ice']">
                            <td>ICE</td>
                            <td class="text-end" t-out="v['ice_amount']"/>
                        </tr>
                        <tr>
                            <td>IVA</td>
                            <td class="text-end" t-out="v['tax_amount']"/>
                        </tr>
                        <tr>
                            <td><strong>VALOR TOTAL</strong></td>
                            <td class="text-end">
                                <strong t-out="v['total_amount']"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

        </div>
    </t>
</template>

<!-- ==================================================================
     Cuerpo: factura (01) y liquidación de compra (03).
     Comparten estructura de detalle; se diferencian en las etiquetas del
     receptor, que el marco ya recibe resueltas.
     ================================================================== -->
<template id="report_ride_body_invoice">
    <table class="table table-sm" style="margin-top:6px; font-size:8pt;">
        <thead>
            <tr>
                <th>Cod. Principal</th>
                <th>Cod. Auxiliar</th>
                <th>Cant.</th>
                <th>Descripción</th>
                <th class="text-end">P. Unitario</th>
                <th class="text-end">Descuento</th>
                <th class="text-end">Precio Total</th>
            </tr>
        </thead>
        <tbody>
            <tr t-foreach="v['lines']" t-as="line">
                <td t-out="v['product_code'](line.product_id)"/>
                <td t-out="line.product_id.barcode or ''"/>
                <td t-out="v['quantity'](line.quantity)"/>
                <td t-out="line.name"/>
                <td class="text-end" t-out="v['quantity'](line.price_unit)"/>
                <td class="text-end"
                    t-out="v['money'](line.price_unit * line.quantity * (line.discount or 0.0) / 100.0)"/>
                <td class="text-end" t-out="v['money'](line.price_subtotal)"/>
            </tr>
        </tbody>
    </table>
</template>

<!-- ==================================================================
     Cuerpo: nota de crédito (04).
     El Anexo 2 exige que declare qué documento modifica y por qué. El RIDE
     anterior no imprimía ninguno de los dos, y además pintaba formas de pago
     que la nota de crédito no lleva.
     ================================================================== -->
<template id="report_ride_body_credit_note">
    <div t-if="v['modified']" style="border:1px solid #000; padding:6px; margin-top:6px;">
        <strong>Comprobante que se modifica</strong>
        <div>
            Tipo: <span t-out="v['modified']['cod_doc']"/>
            <span style="margin-left:12px;">Número:
                <span t-out="v['modified']['num_doc']"/>
            </span>
            <span style="margin-left:12px;">Fecha:
                <span t-out="v['modified']['date']"/>
            </span>
        </div>
        <div>Motivo: <span t-out="v['modified']['reason']"/></div>
    </div>

    <table class="table table-sm" style="margin-top:6px; font-size:8pt;">
        <thead>
            <tr>
                <th>Cod. Interno</th>
                <th>Cant.</th>
                <th>Descripción</th>
                <th class="text-end">P. Unitario</th>
                <th class="text-end">Descuento</th>
                <th class="text-end">Precio Total</th>
            </tr>
        </thead>
        <tbody>
            <tr t-foreach="v['lines']" t-as="line">
                <td t-out="v['product_code'](line.product_id)"/>
                <td t-out="v['quantity'](line.quantity)"/>
                <td t-out="line.name"/>
                <td class="text-end" t-out="v['quantity'](line.price_unit)"/>
                <td class="text-end"
                    t-out="v['money'](line.price_unit * line.quantity * (line.discount or 0.0) / 100.0)"/>
                <td class="text-end" t-out="v['money'](line.price_subtotal)"/>
            </tr>
        </tbody>
    </table>
</template>

<!-- ==================================================================
     Cuerpo: nota de débito (05).
     No lleva detalle de líneas: lleva <motivos>, igual que su XML.
     ================================================================== -->
<template id="report_ride_body_debit_note">
    <div t-if="v['modified']" style="border:1px solid #000; padding:6px; margin-top:6px;">
        <strong>Comprobante que se modifica</strong>
        <div>
            Tipo: <span t-out="v['modified']['cod_doc']"/>
            <span style="margin-left:12px;">Número:
                <span t-out="v['modified']['num_doc']"/>
            </span>
            <span style="margin-left:12px;">Fecha:
                <span t-out="v['modified']['date']"/>
            </span>
        </div>
    </div>

    <table class="table table-sm" style="margin-top:6px; font-size:8pt;">
        <thead>
            <tr>
                <th>Razón de la Modificación</th>
                <th class="text-end">Valor</th>
            </tr>
        </thead>
        <tbody>
            <tr t-foreach="v['motivos']" t-as="motivo">
                <td t-out="motivo['razon']"/>
                <td class="text-end" t-out="v['money'](motivo['valor'])"/>
            </tr>
        </tbody>
    </table>
</template>

<!-- ==================================================================
     Punto de entrada del informe sobre `account.move`.
     ================================================================== -->
<template id="report_invoice_ride">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-set="v" t-value="o._l10n_ec_get_ride_values()"/>
            <t t-call="l10n_ec_sri.report_ride_document"/>
        </t>
    </t>
</template>

</odoo>
