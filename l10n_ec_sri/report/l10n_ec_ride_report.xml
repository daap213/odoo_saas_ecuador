<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_invoice_ride" model="ir.actions.report">
        <field name="name">RIDE (Factura Electrónica)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ec_sri.report_invoice_ride</field>
        <field name="report_file">l10n_ec_sri.report_invoice_ride</field>
        <field name="print_report_name">
            'RIDE - %s' % (object.name or '').replace('/', '-')
        </field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
