<?xml version="1.0" encoding="utf-8"?>
<!--
    Pestaña SRI de la factura: formas de pago, propina y guía referenciada.

    Los tres campos son de emisión, no de contabilidad, así que van juntos y en la
    misma pestaña que el resto de datos del comprobante en vez de repartidos por el
    formulario.
-->
<odoo>
    <record id="view_move_form_l10n_ec_payments" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ec.payments</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Pago y despacho SRI"
                      name="l10n_ec_sri_payments"
                      invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice')">
                    <group>
                        <group>
                            <field name="l10n_ec_tip"/>
                            <field name="l10n_ec_waybill_number"
                                   placeholder="001-001-000000001"/>
                        </group>
                    </group>
                    <separator string="Formas de pago"/>
                    <p class="text-muted">
                        Déjelo vacío para declarar un único pago por el total. Detállelo
                        cuando la venta se cobre de varias formas: el SRI admite un
                        &lt;pago&gt; por cada una.
                    </p>
                    <field name="l10n_ec_payment_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="payment_method_id"/>
                            <field name="amount"/>
                            <field name="term_days"/>
                            <field name="time_unit"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_product_template_form_l10n_ec_tip" model="ir.ui.view">
        <field name="name">product.template.form.l10n.ec.tip</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="taxes_id" position="after">
                <field name="l10n_ec_is_tip"/>
            </field>
        </field>
    </record>
</odoo>
