<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_ec_sri" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n.ec.sri</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Header Buttons -->
            <xpath expr="//header" position="inside">
                 <button name="action_send_sri" string="Send to SRI" type="object" class="oe_highlight"
                         invisible="state != 'posted' or l10n_ec_sri_status in ('sent', 'authorized')"/>
                 <button name="action_check_sri" string="Check SRI Status" type="object"
                         invisible="l10n_ec_sri_status != 'sent'"/>
                 <!-- §4.7: entrega al receptor. El automatismo lo hace al autorizarse;
                      este botón es para reenviar cuando el cliente dice que no llegó. -->
                 <button name="action_l10n_ec_send_to_customer" string="Enviar al cliente"
                         type="object" invisible="l10n_ec_sri_status != 'authorized'"/>
            </xpath>

            <!-- Notebook Page -->
            <xpath expr="//notebook" position="inside">
                <page string="SRI Electronics" name="sri_electronics">
                    <group>
                        <group>
                            <field name="l10n_ec_sri_status" widget="badge"
                                   decoration-success="l10n_ec_sri_status == 'authorized'"
                                   decoration-danger="l10n_ec_sri_status == 'rejected'"
                                   decoration-info="l10n_ec_sri_status == 'sent'"/>
                            <field name="l10n_ec_sri_access_key"/>
                            <field name="l10n_ec_authorization_date"/>
                            <field name="l10n_ec_sent_to_partner"/>
                        </group>
                        <group>
                            <field name="l10n_ec_sri_error" readonly="1" invisible="not l10n_ec_sri_error"/>
                            <field name="l10n_ec_sri_retryable" invisible="not l10n_ec_sri_retryable"/>
                            <field name="l10n_ec_sri_retry_count" invisible="l10n_ec_sri_retry_count == 0"/>
                        </group>
                    </group>
                    <!-- Notas de crédito y de débito: los cuatro datos del documento
                         rectificado son obligatorios para el SRI. Se rellenan solos
                         cuando la nota nace del asistente de reversión; una creada a
                         mano no tiene de dónde sacarlos, así que quedan editables. -->
                    <group string="Documento que rectifica"
                           invisible="move_type not in ('out_refund', 'in_refund') and not l10n_ec_modified_doc_type_id">
                        <group>
                            <field name="l10n_ec_modified_doc_type_id"
                                   options="{'no_create': True}"/>
                            <field name="l10n_ec_modified_doc_number"
                                   placeholder="001-001-000000001"/>
                        </group>
                        <group>
                            <field name="l10n_ec_modified_doc_date"/>
                            <field name="l10n_ec_modification_reason"
                                   placeholder="Devolución de mercadería"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
