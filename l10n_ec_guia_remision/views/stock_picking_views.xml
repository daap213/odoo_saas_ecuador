<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_picking_form_inherit_l10n_ec_stock" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.l10n_ec_stock</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                   <!-- El envio se oculta tambien en 'sent' y en el rechazo
                        definitivo: reenviar un comprobante que el SRI ya tiene solo
                        devuelve el codigo 43. -->
                   <button name="action_send_guia_sri" string="Enviar Guía al SRI"
                           type="object" class="oe_highlight"
                           invisible="state != 'done' or l10n_ec_sri_status in ('authorized', 'sent', 'rejected_final')"/>
                   <button name="action_check_guia_sri" string="Consultar autorización"
                           type="object"
                           invisible="l10n_ec_sri_status not in ('sent', 'rejected')"/>
                </xpath>
                <xpath expr="//page[@name='extra']" position="after">
                    <page string="Transport Info (Guía de Remisión)" name="guia_remision" invisible="picking_type_code == 'incoming'">
                        <group>
                            <group string="Transport Details">
                                <field name="l10n_ec_transport_reason"/>
                                <field name="l10n_ec_start_date"/>
                                <field name="l10n_ec_end_date"/>
                                <field name="l10n_ec_route"
                                       placeholder="Quito - Ambato vía Panamericana"/>
                                <field name="l10n_ec_sustento_move_id"
                                       options="{'no_create': True}"/>
                                <field name="l10n_ec_destination_establishment"
                                       placeholder="002"/>
                                <field name="l10n_ec_customs_document"
                                       invisible="l10n_ec_transport_reason not in ('exportacion',)"/>
                            </group>
                            <group string="Fleet">
                                <field name="l10n_ec_driver_id"/>
                                <field name="l10n_ec_vehicle_id"/>
                            </group>
                            <group string="SRI Status">
                                <field name="l10n_ec_guia_number" readonly="1"/>
                                <field name="l10n_ec_sri_status"/>
                                <field name="l10n_ec_sri_access_key" readonly="1"/>
                                <field name="l10n_ec_authorization_date" readonly="1"
                                       invisible="l10n_ec_sri_status != 'authorized'"/>
                                <field name="l10n_ec_sri_error" readonly="1"
                                       invisible="not l10n_ec_sri_error"/>
                                <field name="l10n_ec_sri_retry_count" readonly="1"
                                       invisible="l10n_ec_sri_retry_count == 0"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
