<?xml version="1.0" encoding="utf-8"?>
<!--
    Añade el ambiente SRI, el certificado y los datos del emisor al bloque
    "Ecuador — SRI" que crea l10n_ec_base. Se separa así porque los campos que
    reflejan viven en res.company y los declara este módulo, no l10n_ec_base.
-->
<odoo>

    <record id="res_config_settings_view_form_l10n_ec_edi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ec_edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ec_base.res_config_settings_view_form_l10n_ec"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='l10n_ec_auto_send_setting']" position="before">

                <setting id="l10n_ec_environment_setting"
                         string="Ambiente y firma"
                         help="Ambiente contra el que se transmite y certificado con el que se firman los comprobantes.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="l10n_ec_sri_environment" class="col-lg-5 o_light_label"/>
                            <field name="l10n_ec_sri_environment"/>
                        </div>
                        <div class="row">
                            <label for="l10n_ec_certificate_id" class="col-lg-5 o_light_label"/>
                            <field name="l10n_ec_certificate_id" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>

                <setting id="l10n_ec_issuer_setting"
                         string="Datos del emisor en el comprobante"
                         help="Etiquetas que el SRI exige según la calificación de la empresa. Vacío = no se emiten.">
                    <div class="content-group">
                        <div class="row mt16">
                            <field name="l10n_ec_forced_accounting"/>
                            <label for="l10n_ec_forced_accounting" class="o_light_label"/>
                        </div>
                        <div class="row">
                            <label for="l10n_ec_special_resolution" class="col-lg-5 o_light_label"/>
                            <field name="l10n_ec_special_resolution"/>
                        </div>
                        <div class="row">
                            <field name="l10n_ec_withhold_agent"/>
                            <label for="l10n_ec_withhold_agent" class="o_light_label"/>
                        </div>
                        <div class="row">
                            <label for="l10n_ec_withhold_resolution" class="col-lg-5 o_light_label"/>
                            <field name="l10n_ec_withhold_resolution"
                                   invisible="not l10n_ec_withhold_agent"/>
                        </div>
                        <div class="row">
                            <label for="l10n_ec_big_taxpayer_resolution" class="col-lg-5 o_light_label"/>
                            <field name="l10n_ec_big_taxpayer_resolution"/>
                        </div>
                    </div>
                </setting>

            </xpath>
        </field>
    </record>

</odoo>
