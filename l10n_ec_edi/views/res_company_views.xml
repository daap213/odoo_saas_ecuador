<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_l10n_ec_edi" model="ir.ui.view">
        <field name="name">res.company.form.l10n.ec.edi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ecuador SRI" name="l10n_ec_sri">
                    <group>
                        <group string="Facturación electrónica">
                            <field name="l10n_ec_sri_environment" widget="radio"
                                   string="Ambiente"/>
                            <field name="l10n_ec_certificate_id"
                                   string="Firma electrónica (.p12)"/>
                            <field name="l10n_ec_commercial_name"
                                   string="Nombre comercial"/>
                        </group>
                        <group string="Contribuyente">
                            <field name="l10n_ec_withhold_agent"
                                   string="Agente de retención"/>
                            <field name="l10n_ec_withhold_resolution"
                                   string="No. resolución de retención"
                                   invisible="not l10n_ec_withhold_agent"/>
                            <field name="l10n_ec_special_resolution"
                                   string="Resolución contribuyente especial"/>
                            <field name="l10n_ec_forced_accounting"
                                   string="Obligado a llevar contabilidad"/>
                        </group>
                    </group>
                    <group string="Servicios web del SRI" groups="base.group_system">
                        <field name="l10n_ec_sri_reception_url" string="URL de recepción"/>
                        <field name="l10n_ec_sri_authorization_url" string="URL de autorización"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
